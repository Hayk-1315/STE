NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_PROFILE=sepolia
NEXT_PUBLIC_READ_ONLY=false
NEXT_PUBLIC_ZEROEX_EXCHANGE_PROXY=0xdef1c0ded9bec7f1a1670819833240f027b25eff
# Required for wallet connection (Web3Auth). Get a client ID at console.web3auth.io.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=YOUR_WEB3AUTH_CLIENT_ID
# Web3Auth network. Use sapphire_devnet for local/Sepolia QA.
NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet
# Turn on the SEA / Smart Intents UI surface (intent panel, CMR Execute row).
# Required for any CMR manual QA: create CL, create CMR, cancel intent,
# wallet-lock, Execute READY CMR.
NEXT_PUBLIC_SEA_ENABLED=true
# Phase 6: AI Assist box inside the Conditional tab (interactive QA). Requires
# the API to have SEA_AI_ENABLED=1 + ANTHROPIC_API_KEY set; otherwise the box
# shows an "AI unavailable" state and the manual form still works.
NEXT_PUBLIC_SEA_AI_ENABLED=true
# Phase 3b: opt-in delegated CMR (Nexus Smart Account) UI. Default false so the
# Conditional tab renders exactly the manual flow. Set true for delegated Sepolia
# QA (requires the API to have SEA_DELEGATED_ENABLED=1 + a session signer).
# Only injected wallets (MetaMask) get delegated mode; Web3Auth is unproven/
# disabled and the EIP-7702 browser path is disabled/deferred.
NEXT_PUBLIC_SEA_DELEGATED_ENABLED=false