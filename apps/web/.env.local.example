NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_PROFILE=mainnet
NEXT_PUBLIC_READ_ONLY=true
NEXT_PUBLIC_ZEROEX_EXCHANGE_PROXY=0xdef1c0ded9bec7f1a1670819833240f027b25eff
# Turn on the SEA / Smart Intents UI surface (intent panel, CMR Execute row).
# Action buttons additionally require NEXT_PUBLIC_READ_ONLY=false AND
# NEXT_PUBLIC_PROFILE != mainnet. With this flag plus a read-only profile
# the UI is visible but every action stays disabled / shows the read-only
# toast.
NEXT_PUBLIC_SEA_ENABLED=true
# Phase 6: AI Assist. Shown as a product preview on the read-only mainnet demo,
# but fully NON-interactive: textarea / Preview / Apply are disabled and the UI
# never calls /sea/ai/parse, so the backend needs no key and there is no cost.
NEXT_PUBLIC_SEA_AI_ENABLED=true