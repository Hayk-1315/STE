DATABASE_URL="postgresql://ste:ste@localhost:5432/ste?schema=public"
CHAIN_ID=11155111
RPC_URL_READONLY=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
READ_ONLY=false
# Explicit profile. Required so the Sepolia launcher does not inherit
# PROFILE=mainnet from apps/api/.env (which would disable the SEA monitor).
PROFILE=sepolia
PORT=3001
API_CORS_ORIGINS=http://localhost:3000
ZEROEX_EXCHANGE_PROXY=0xdef1c0ded9bec7f1a1670819833240f027b25eff
ZEROEX_ALLOWANCE_SPENDER=0xdef1c0ded9bec7f1a1670819833240f027b25eff
FEE_RECIPIENT=0x0000000000000000000000000000000000000000
TAKER_FEE_BPS=100

# --- SEA (Smart Execution Assistant) ---
# Phase 3 monitor is opt-in. Hard-disabled in READ_ONLY=true and PROFILE=mainnet.
# Set to 1 to enable CL trigger monitoring and CMR readiness evaluation.
SEA_MONITOR_ENABLED=1
# Monitor tick cadence (ms). Min 250.
SEA_MONITOR_INTERVAL_MS=1000
# Max active CL intents evaluated per tick.
SEA_MONITOR_LIMIT_PER_TICK=100
# Optional safety delay before the first tick (ms). 0 = rely on OnApplicationBootstrap.
SEA_MONITOR_BOOT_DELAY_MS=0
# Required slack between intent.expiresAt and the underlying 0x order.expiry, in seconds.
SEA_FIRE_EXPIRY_GRACE_SECS=60
# Phase 3.x-a: intent expiry sweeper (DRAFT/ACTIVE → EXPIRED). Default-on.
# Hard-disabled in READ_ONLY=true and PROFILE=mainnet.
SEA_INTENT_EXPIRY_ENABLED=1
# Sweeper tick cadence (ms). Min 1000.
SEA_INTENT_EXPIRY_INTERVAL_MS=30000
# Max intents transitioned per tick (cap 500).
SEA_INTENT_EXPIRY_LIMIT_PER_TICK=100
# Phase 4: CMR readiness sub-gate. Only honored when SEA_MONITOR_ENABLED=1.
# Hard-disabled in READ_ONLY=true and PROFILE=mainnet.
# Set to 1 for full CMR ACTIVE→READY lifecycle.
SEA_CMR_PREPARE_ENABLED=1
# Freshness window (seconds) for the persisted preparedQuote snapshot.
# Not intent expiry; not a liquidity reservation. Clamped to [5, 300].
SEA_CMR_READY_TTL_SECS=60
# Cooldown applied after READY → ACTIVE re-arm so the next tick does not
# immediately re-prepare. Clamped to [0, 60].
SEA_CMR_REARM_COOLDOWN_SECS=5
# Debounce window (seconds) for repeated insufficient_liquidity PROGRESS
# events while ACTIVE. Clamped to [5, 600].
SEA_CMR_PROGRESS_DEBOUNCE_SECS=60
# Phase 4.x-b: CMR execution-lifecycle tracking.
SEA_WALLET_LOCK_SEC=300
# REQUIRED for CMR wallet-lock (PROFILE=sepolia has no dev fallback).
# Generate with: openssl rand -base64 32
# Both values must be set and must be DIFFERENT from each other. Min 16 chars.
SEA_LOCK_NONCE_SECRET=
SEA_EXECUTION_TOKEN_SECRET=
# Phase 4.x-d: stale EXECUTING sweeper (opt-in safety net).
SEA_EXECUTING_SWEEP_ENABLED=0
SEA_EXECUTING_STALE_MIN=10
SEA_EXECUTING_SWEEP_INTERVAL_MS=30000
SEA_EXECUTING_SWEEP_LIMIT_PER_TICK=100
# Phase 6: SEA AI Assist (natural-language parse endpoint, POST /sea/ai/parse).
# Opt-in for LOCAL QA. When 1 + a real key, "Preview intent" calls the Anthropic
# provider (server-side only). Off (0 or absent) => aiUnavailable; the manual
# CMR/CL form is unaffected. The LLM is an extractor only; deterministic
# validation is the source of truth and never auto-executes.
# WARNING — DEPLOYED/PUBLIC Sepolia: the endpoint is unauthenticated and
# unthrottled, so SEA_AI_ENABLED=1 + a real key means public Preview clicks bill
# the key owner. Keep SEA_AI_ENABLED=0 on public deploys unless running
# controlled QA, then set it back to 0 (and/or clear the key) afterwards.
SEA_AI_ENABLED=1
# Anthropic API key — SERVER-SIDE ONLY (never a NEXT_PUBLIC_* var). Add your own
# key locally to use live AI (billed to the key owner). Empty keeps AI
# unavailable. NEVER commit a real key.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to the alias claude-haiku-4-5; set the dated
# snapshot for deterministic pinning. Model choice affects per-call cost.
# SEA_AI_MODEL=claude-haiku-4-5-20251001

# --- On-chain watchers (FillWatcher + CancelWatcher) ---
# Master gate (legacy, still works): enables BOTH watchers. Requires a working
# RPC_URL_READONLY. Set to 0 for API/UI boot without on-chain reconciliation
# (e.g. when RPC quota is exhausted).
DEV_ONCHAIN_WATCHER=1
# Per-watcher overrides (Phase RPC-1). Unset = inherit DEV_ONCHAIN_WATCHER;
# "1" enables, "0" disables that watcher independently (run only one to cut RPC).
# DEV_FILL_WATCHER=
# DEV_CANCEL_WATCHER=
# Bounded catch-up: max blocks fetched per tick after downtime. Default 100,
# clamped to [1, 500].
CANCEL_WATCHER_MAX_BLOCKS_PER_TICK=100
FILL_WATCHER_MAX_BLOCKS_PER_TICK=100
# Poll cadence per watcher (ms). Default 2000, floored at 500. Sepolia blocks are
# ~12s, so raising these (e.g. 6000-12000) cuts wasted head-polling RPC usage.
FILL_WATCHER_INTERVAL_MS=6000
CANCEL_WATCHER_INTERVAL_MS=6000
# Transient-error cooldown (429 / quota / timeout / capacity), shared by both
# watchers. On a transient RPC error the watcher pauses (cursor NOT advanced)
# for an exponential delay between BASE and MAX ms, then retries. Defaults 15s/120s.
# WATCHER_RPC_BACKOFF_BASE_MS=15000
# WATCHER_RPC_BACKOFF_MAX_MS=120000

# --- Delegated CMR (Phase 3b: Nexus Smart Account; OFF by default) ---
# Optional, opt-in second CMR execution mode: the user authorizes once and a
# backend-held, policy-scoped SESSION key (NEVER the user's key) executes the 0x
# fill later. CMR-only; manual CMR and CL are unaffected. ethereum-sepolia is a
# WRITABLE profile and CAN be enabled for QA (set the three flags below to 1/1/
# biconomy + a session signer). Capability notes: only the Nexus Smart Account
# model + injected wallets (MetaMask) are supported; Web3Auth delegated signing
# is UNPROVEN/disabled and the EIP-7702 browser path is DISABLED/deferred.
# Base Mainnet stays read-only/hard-disabled regardless of these flags.
SEA_DELEGATED_ENABLED=0
# Executor worker gate. Boots the in-API executor only when ENABLED=1 too +
# a session signer is set. Default OFF.
SEA_DELEGATED_EXEC_ENABLED=0
# Provider: mock (default; no network) | biconomy (real Nexus + Smart Sessions).
# Set to biconomy for delegated Sepolia QA.
SEA_DELEGATED_PROVIDER=mock
# Reference-only values proven in the Phase 0 spike (inert until a later phase).
# The bundler is the standard Alchemy Sepolia endpoint (RPC doubles as a 4337
# bundler). These are NON-SECRET references, not keys.
# DELEGATION_NEXUS_IMPLEMENTATION=0x000000004F43C49e93C970E84001853a70923B03
# Nexus account factory (NEXUS_SA model): derives the counterfactual SA from the
# owner address and reports deploy state. Verified on Sepolia in the Phase 3b.0 spike.
# DELEGATION_NEXUS_FACTORY=0x000000001D1D5004a02bAfAb9de2D6CE5b7B13de
# DELEGATION_SMART_SESSIONS_MODULE=0x00000000008bDABA73cD9815d79069c247Eb4bDA
# DELEGATION_BUNDLER_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# NON-SECRET label pointing at the backend-held session signer (never a key).
# DELEGATION_EXECUTOR_KEY_REF=
# Executor cadence (Phase 2). Only used when the executor gate is open.
SEA_DELEGATED_EXEC_INTERVAL_MS=5000
SEA_DELEGATED_EXEC_LIMIT_PER_TICK=10
# Grant spend-cap fee buffer over the trigger notional, in bps. Default 200 (2%).
DELEGATION_FEE_BUFFER_BPS=200
# Backend SESSION signer private key. SERVER-ONLY; NEVER a user key; NEVER
# logged; NEVER exposed to the frontend. Rotating it invalidates outstanding
# grants (they expire). Empty by default — set your OWN throwaway Sepolia key
# locally to exercise the executor. NEVER commit a real value.
DELEGATION_SESSION_SIGNER_PK=