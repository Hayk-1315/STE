DATABASE_URL="postgresql://ste:ste@localhost:5432/ste?schema=public"
CHAIN_ID=8453
RPC_URL_READONLY=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
READ_ONLY=true
# Explicit profile. With READ_ONLY=true the monitor/write paths are already
# hard-disabled, but an explicit PROFILE ensures the mainnet guard also applies
# at every gate in the codebase.
PROFILE=mainnet
PORT=3001
API_CORS_ORIGINS=http://localhost:3000
ZEROEX_EXCHANGE_PROXY=0xdef1c0ded9bec7f1a1670819833240f027b25eff
ZEROEX_ALLOWANCE_SPENDER=0xdef1c0ded9bec7f1a1670819833240f027b25eff
FEE_RECIPIENT=0x0000000000000000000000000000000000000000
TAKER_FEE_BPS=0

# --- SEA (Smart Execution Assistant) ---
# Phase 3 monitor is opt-in. Hard-disabled in READ_ONLY=true and PROFILE=mainnet.
SEA_MONITOR_ENABLED=0
# Monitor tick cadence (ms). Min 250.
SEA_MONITOR_INTERVAL_MS=1000
# Max active CL intents evaluated per tick.
SEA_MONITOR_LIMIT_PER_TICK=100
# Optional safety delay before the first tick (ms). 0 = rely on OnApplicationBootstrap.
SEA_MONITOR_BOOT_DELAY_MS=0
# Required slack between intent.expiresAt and the underlying 0x order.expiry, in seconds.
SEA_FIRE_EXPIRY_GRACE_SECS=60
# Phase 3.x-a: intent expiry sweeper (DRAFT/ACTIVE → EXPIRED). Default-on.
# Hard-disabled in READ_ONLY=true and PROFILE=mainnet.
SEA_INTENT_EXPIRY_ENABLED=1
# Sweeper tick cadence (ms). Min 1000.
SEA_INTENT_EXPIRY_INTERVAL_MS=30000
# Max intents transitioned per tick (cap 500).
SEA_INTENT_EXPIRY_LIMIT_PER_TICK=100
# Phase 4: CMR readiness sub-gate. Only honored when SEA_MONITOR_ENABLED=1.
# Hard-disabled in READ_ONLY=true and PROFILE=mainnet. Default-off.
SEA_CMR_PREPARE_ENABLED=0
# Freshness window (seconds) for the persisted preparedQuote snapshot.
# Not intent expiry; not a liquidity reservation. Clamped to [5, 300].
SEA_CMR_READY_TTL_SECS=60
# Cooldown applied after READY → ACTIVE re-arm so the next tick does not
# immediately re-prepare. Clamped to [0, 60].
SEA_CMR_REARM_COOLDOWN_SECS=5
# Debounce window (seconds) for repeated insufficient_liquidity PROGRESS
# events while ACTIVE. Clamped to [5, 600].
SEA_CMR_PROGRESS_DEBOUNCE_SECS=60
# Phase 4.x-b: CMR execution-lifecycle tracking.
# Wallet-lock duration in seconds. The lock is clamped to
# min(now + SEA_WALLET_LOCK_SEC, intent.expiresAt); hard expiry strictly
# wins. Default 300 (5 min) gives the user time to confirm in MetaMask.
SEA_WALLET_LOCK_SEC=300
# HMAC secret used to mint stateless lockNonces returned by
# GET /sea/intents/:id/fresh-quote. REQUIRED in non-dev. Dev fallback only
# when PROFILE=dev OR (PROFILE unset AND DEV_SKIP_SIGS=1). Min 16 chars.
SEA_LOCK_NONCE_SECRET=
# HMAC secret used to mint stateless executionTokens returned by
# POST /sea/intents/:id/wallet-lock. REQUIRED in non-dev. Same dev rules.
# Min 16 chars. Must be DIFFERENT from SEA_LOCK_NONCE_SECRET.
SEA_EXECUTION_TOKEN_SECRET=
# Phase 4.x-d: stale EXECUTING sweeper. Opt-in safety net that
# transitions EXECUTING CMR intents to FAILED('stale_pending') when
# FillWatcher never closes them (RPC blackhole, replaced-by-fee, etc).
# Default OFF. Hard-disabled in READ_ONLY=true OR PROFILE=mainnet (OR).
# Scope: only EXECUTING rows. Does NOT recover rows stuck in READY
# after wallet-lock when /executing was never posted — that path is
# handled by the monitor re-arm after walletLockUntilAt expires.
SEA_EXECUTING_SWEEP_ENABLED=0
# Stale threshold in minutes (clamped to [1, 1440]).
SEA_EXECUTING_STALE_MIN=10
# Tick cadence in ms (clamped to >= 1000).
SEA_EXECUTING_SWEEP_INTERVAL_MS=30000
# Max rows transitioned per tick (clamped to [1, 500]).
SEA_EXECUTING_SWEEP_LIMIT_PER_TICK=100
# Phase 6: SEA AI Assist (POST /sea/ai/parse). Default OFF here. Base
# mainnet/read-only needs NO key — the read-only UI never calls the endpoint.
# Enable only on interactive profiles (e.g. Sepolia). The LLM is an extractor;
# deterministic validation is authoritative and never auto-executes.
SEA_AI_ENABLED=0
# Anthropic API key — SERVER-SIDE ONLY (never NEXT_PUBLIC_*). Empty keeps AI
# unavailable even if SEA_AI_ENABLED=1. NEVER commit a real key.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to the alias claude-haiku-4-5; set the dated
# snapshot for deterministic pinning. Model choice affects per-call cost.
# SEA_AI_MODEL=claude-haiku-4-5-20251001

# --- On-chain watchers (FillWatcher + CancelWatcher) ---
# Master gate (legacy, still works): enables BOTH watchers' on-chain
# reconciliation so SEA EXECUTING → EXECUTED/FAILED (Phase 4.x-c) drives off
# real RPC. Requires a working RPC_URL_READONLY. Default 0.
DEV_ONCHAIN_WATCHER=0
# Per-watcher overrides (Phase RPC-1). Unset = inherit DEV_ONCHAIN_WATCHER;
# "1" enables, "0" disables that watcher independently (run only one to cut RPC).
# DEV_FILL_WATCHER=
# DEV_CANCEL_WATCHER=
# Bounded catch-up: max blocks fetched per tick after downtime. Default 100,
# clamped to [1, 500]. Lower = smaller RPC burst, slower catch-up.
CANCEL_WATCHER_MAX_BLOCKS_PER_TICK=100
FILL_WATCHER_MAX_BLOCKS_PER_TICK=100
# Poll cadence per watcher (ms). Default 2000, floored at 500. Raise on slow
# chains (e.g. 6000-12000 on Sepolia) to cut head-polling RPC usage.
# FILL_WATCHER_INTERVAL_MS=2000
# CANCEL_WATCHER_INTERVAL_MS=2000
# Transient-error cooldown (429 / quota / timeout / capacity), shared by both
# watchers. On a transient RPC error the watcher pauses (cursor NOT advanced)
# for an exponential delay between BASE and MAX ms, then retries. Defaults 15s/120s.
# WATCHER_RPC_BACKOFF_BASE_MS=15000
# WATCHER_RPC_BACKOFF_MAX_MS=120000

# --- Delegated CMR (Phase 1 scaffold; DISABLED by default) ---
# Optional second CMR execution mode: the user authorizes once and a backend-held,
# policy-scoped SESSION key (never the user's key) executes the 0x fill later.
# CMR-only; manual CMR and CL are unaffected. Fully disabled unless
# SEA_DELEGATED_ENABLED=1 on a WRITABLE profile.
# base-mainnet is HARD-DISABLED / read-only at runtime regardless of this flag:
# no grant creation, no session install, no revoke tx, no executor, no API write
# path, and NO Base secrets/paymaster/executor funding required.
# --- Delegated CMR (Phase 3b). This is the base-mainnet profile: delegated
# writes are HARD-DISABLED/read-only here regardless of these flags. Keep OFF.
# Session signer, factory, and executor are NOT required/used while read-only.
SEA_DELEGATED_ENABLED=0
# Executor worker gate. Never boots on base-mainnet/READ_ONLY. Default OFF.
SEA_DELEGATED_EXEC_ENABLED=0
# Provider: mock (default; no network) | biconomy. Stays mock on base-mainnet.
SEA_DELEGATED_PROVIDER=mock
# Reference-only addresses/URLs (inert until a later phase). NOT secrets.
# Left empty on base-mainnet while read-only — no Base secrets are needed.
# DELEGATION_NEXUS_IMPLEMENTATION=
# Nexus account factory (NEXUS_SA model): derives the counterfactual SA + deploy state.
# TODO(base-activation): the Base Mainnet Nexus factory address is NOT verified
# here — do NOT reuse the Sepolia value blindly. Confirm the Base deployment
# before enabling delegated writes on Base (they stay hard-disabled until then).
# DELEGATION_NEXUS_FACTORY=
# DELEGATION_SMART_SESSIONS_MODULE=
# DELEGATION_BUNDLER_URL=
# NON-SECRET label pointing at the backend-held session signer (never a key).
# DELEGATION_EXECUTOR_KEY_REF=
# Executor cadence (Phase 2). Only used when the executor gate is open.
SEA_DELEGATED_EXEC_INTERVAL_MS=5000
SEA_DELEGATED_EXEC_LIMIT_PER_TICK=10
# Grant spend-cap fee buffer over the trigger notional, in bps. Default 200 (2%).
DELEGATION_FEE_BUFFER_BPS=200
# Backend SESSION signer private key. SERVER-ONLY; NEVER a user key; NEVER
# logged; NEVER exposed to the frontend. Rotating it invalidates outstanding
# grants (they expire). On base-mainnet this stays EMPTY — the feature is
# hard-disabled/read-only and needs no signer. NEVER commit a real value.
DELEGATION_SESSION_SIGNER_PK=