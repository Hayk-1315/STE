# STE — example environment file
# Copy this to apps/api/.env and apps/web/.env.local as needed.
# Values here are illustrative. Replace with your actual hosts/keys.

########################################
# Common (both profiles)
########################################
# Postgres (API only)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ste

# 0x Exchange Proxy (same address on Base mainnet & Ethereum sepolia)
EXCHANGE_PROXY=0xdef1c0ded9bec7f1a1670819833240f027b25eff

########################################
# DEV profile (Base Sepolia) — interactive
########################################
# API
RPC_URL=https://rpc.sepolia.org
RPC_URL_READONLY=https://rpc.sepolia.org
READ_ONLY=false

# WEB
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_PROFILE=sepolia

########################################
# DEMO profile (Base Mainnet, read-only)
########################################
# API
# RPC_URL=https://mainnet.base.org
# RPC_URL_READONLY=https://mainnet.base.org
# READ_ONLY=true

# WEB
# NEXT_PUBLIC_API_BASE_URL=https://api-demo.example.com
# NEXT_PUBLIC_CHAIN_ID=8453
# NEXT_PUBLIC_PROFILE=mainnet
