{
  "name": "ste",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint-staged": "lint-staged",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker logs -f ste_postgres",
    "db:psql": "docker exec -it ste_postgres psql -U ste -d ste",
    "api:dev": "pnpm --filter ./apps/api start:dev",
    "web:dev": "pnpm --filter ./apps/web dev",
    "format": "prettier -w \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier -c \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "prepare": "husky install"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,jsx}": "pnpm --filter ./apps/web exec eslint --fix --",
    "apps/api/src/**/*.{ts,tsx}": "pnpm --filter ./apps/api exec eslint --fix --",
    "*.{json,md,yml,yaml}": "pnpm exec prettier -w"
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "lint-staged": "16.2.6",
    "prettier": "^3.6.2"
  }
}
